import 'package:latin_reader/src/component/word_frequency/word_frequency_api.dart';
import 'package:latin_reader/src/component/word_frequency/resolved_freq_morph_form_api.dart';
import 'package:latin_reader/src/component/word_frequency/text_coverage_api.dart';

-- Occurrence counts for each work, plain form, and macronized spelling
CREATE TABLE "ScopedFormFreq"(
    "workId" TEXT NOT NULL,
    "form" TEXT NOT NULL,
    "macronForm" TEXT NOT NULL,
    "occurrences" INTEGER NOT NULL CHECK( occurrences > 0 ),
    PRIMARY KEY( workId, form, macronForm )
)
STRICT,
WITHOUT ROWID;

-- Stores the morphological matches found while populating the frequency tables,
-- for each work, plain form, and macronized form.
-- morphForm and morphItem identify the matching MorphologicalDetails record.
-- A counted form can have several matches.
CREATE TABLE "ResolvedFreqMorphForms"(
    "workId" TEXT NOT NULL,
    "form" TEXT NOT NULL,
    "macronForm" TEXT NOT NULL,
    "morphForm" TEXT NOT NULL,
    "morphItem" INTEGER NOT NULL,
    "dictionaryRef" TEXT NOT NULL,
    PRIMARY KEY( workId, form, macronForm, morphForm, morphItem )
)
STRICT,
WITHOUT ROWID;

CREATE INDEX "ResolvedFreqMorphForms_Lemma"
    ON ResolvedFreqMorphForms( workId, dictionaryRef );

-- Candidate-lemma counts for each work, plain form, and macronized form.
-- possibleOccurrences counts units that have this lemma as a candidate.
-- singleCandidateOccurrences counts units with no other candidate lemma.
-- A unit can contribute to possibleOccurrences for several lemmas.
CREATE TABLE "ScopedFormLemmaFreq"(
    "workId" TEXT NOT NULL,
    "form" TEXT NOT NULL,
    "macronForm" TEXT NOT NULL,
    "dictionaryRef" TEXT NOT NULL,
    "possibleOccurrences" INTEGER NOT NULL CHECK( possibleOccurrences > 0 ),
    "singleCandidateOccurrences" INTEGER NOT NULL
        CHECK( singleCandidateOccurrences BETWEEN 0 AND possibleOccurrences ),
    PRIMARY KEY( workId, form, macronForm, dictionaryRef )
)
STRICT,
WITHOUT ROWID;

CREATE INDEX "ScopedFormLemmaFreq_MacronForm"
    ON ScopedFormLemmaFreq( macronForm, workId );

CREATE TABLE "ScopedLemmaFreq"(
    "workId" TEXT NOT NULL,
    "dictionaryRef" TEXT NOT NULL,
    "possibleOccurrences" INTEGER NOT NULL CHECK( possibleOccurrences > 0 ),
    "singleCandidateOccurrences" INTEGER NOT NULL
        CHECK( singleCandidateOccurrences BETWEEN 0 AND possibleOccurrences ),
    PRIMARY KEY( workId, dictionaryRef )
)
STRICT,
WITHOUT ROWID;

-- Totals for each work. The three candidate categories sum to totalTokens.
-- Distinct form and lemma totals cannot simply be added across works:
-- the same form or lemma may occur in several works.
CREATE TABLE "ScopedFreqTotals"(
    "workId" TEXT NOT NULL,
    "totalForms" INTEGER NOT NULL, -- don't aggregate, just for reference
    "totalMacronForms" INTEGER NOT NULL, -- don't aggregate, just for reference
    "totalLemmas" INTEGER NOT NULL, -- don't aggregate, just for reference
    "totalTokens" INTEGER NOT NULL,
    "noCandidateTokens" INTEGER NOT NULL CHECK( noCandidateTokens >= 0 ),
    "singleCandidateTokens" INTEGER NOT NULL CHECK( singleCandidateTokens >= 0 ),
    "multipleCandidateTokens" INTEGER NOT NULL CHECK( multipleCandidateTokens >= 0 ),
    PRIMARY KEY( workId ),
    CHECK( totalTokens = noCandidateTokens + singleCandidateTokens + multipleCandidateTokens )
)
STRICT,
WITHOUT ROWID;

-- Identical display forms can have different candidate sets, so group by lookup.
CREATE TABLE "ScopedLookupFreq"(
    "workId" TEXT NOT NULL,
    "lookupForm" TEXT NOT NULL,
    "alsoLowercase" BOOLEAN NOT NULL, -- properNounState = 2
    "occurrences" INTEGER NOT NULL CHECK( occurrences > 0 ),
    PRIMARY KEY( workId, lookupForm, alsoLowercase )
)
STRICT,
WITHOUT ROWID;

-- no rows for a lookup means it has no candidate lemma
CREATE TABLE "ScopedLookupLemmas"(
    "workId" TEXT NOT NULL,
    "lookupForm" TEXT NOT NULL,
    "alsoLowercase" BOOLEAN NOT NULL,
    "dictionaryRef" TEXT NOT NULL,
    PRIMARY KEY( workId, lookupForm, alsoLowercase, dictionaryRef )
)
STRICT,
WITHOUT ROWID;

-- Count occurrences of each plain form across the selected works.
-- Select the requested page before collecting candidate lemmas.
-- This avoids collecting lemmas for forms that are not on the page.
-- Candidate lemmas are restricted to the same selected works.
getFormFrequenciesDesc WITH FormFrequencyRow.fromFormSql:
    WITH Page AS ( SELECT form,
                          SUM( occurrences ) AS occurrences
                       FROM ScopedFormFreq
                       WHERE workId IN :workIds
                       GROUP BY form
                       ORDER BY occurrences DESC, form
                       LIMIT :limit OFFSET :offset )
    SELECT Page.form,
           Page.occurrences,
           ( SELECT GROUP_CONCAT( DISTINCT ScopedFormLemmaFreq.dictionaryRef )
                 FROM ScopedFormLemmaFreq
                 WHERE ScopedFormLemmaFreq.form = Page.form
                       AND ScopedFormLemmaFreq.workId IN :workIds ) AS possibleLemmas
        FROM Page
        ORDER BY Page.occurrences DESC, Page.form;

getFormFrequenciesAsc WITH FormFrequencyRow.fromFormSql:
    WITH Page AS ( SELECT form,
                          SUM( occurrences ) AS occurrences
                       FROM ScopedFormFreq
                       WHERE workId IN :workIds
                       GROUP BY form
                       ORDER BY occurrences ASC, form
                       LIMIT :limit OFFSET :offset )
    SELECT Page.form,
           Page.occurrences,
           ( SELECT GROUP_CONCAT( DISTINCT ScopedFormLemmaFreq.dictionaryRef )
                 FROM ScopedFormLemmaFreq
                 WHERE ScopedFormLemmaFreq.form = Page.form
                       AND ScopedFormLemmaFreq.workId IN :workIds ) AS possibleLemmas
        FROM Page
        ORDER BY Page.occurrences ASC, Page.form;

-- Form frequency - macrons ON -> group by macron form
getMacronFormFrequenciesDesc WITH FormFrequencyRow.fromMacronFormSql:
    WITH Page AS ( SELECT macronForm,
                          MIN( form ) AS form,
                          SUM( occurrences ) AS occurrences
                       FROM ScopedFormFreq
                       WHERE workId IN :workIds
                       GROUP BY macronForm
                       ORDER BY occurrences DESC, macronForm
                       LIMIT :limit OFFSET :offset )
    SELECT Page.macronForm,
           Page.form,
           Page.occurrences,
           ( SELECT GROUP_CONCAT( DISTINCT ScopedFormLemmaFreq.dictionaryRef )
                 FROM ScopedFormLemmaFreq
                 WHERE ScopedFormLemmaFreq.macronForm = Page.macronForm
                       AND ScopedFormLemmaFreq.workId IN :workIds ) AS possibleLemmas
        FROM Page
        ORDER BY Page.occurrences DESC, Page.macronForm;

getMacronFormFrequenciesAsc WITH FormFrequencyRow.fromMacronFormSql:
    WITH Page AS ( SELECT macronForm,
                          MIN( form ) AS form,
                          SUM( occurrences ) AS occurrences
                       FROM ScopedFormFreq
                       WHERE workId IN :workIds
                       GROUP BY macronForm
                       ORDER BY occurrences ASC, macronForm
                       LIMIT :limit OFFSET :offset )
    SELECT Page.macronForm,
           Page.form,
           Page.occurrences,
           ( SELECT GROUP_CONCAT( DISTINCT ScopedFormLemmaFreq.dictionaryRef )
                 FROM ScopedFormLemmaFreq
                 WHERE ScopedFormLemmaFreq.macronForm = Page.macronForm
                       AND ScopedFormLemmaFreq.workId IN :workIds ) AS possibleLemmas
        FROM Page
        ORDER BY Page.occurrences ASC, Page.macronForm;

-- Lemma frequency (macron toggle is a no-op since counts can't differ)
getLemmaFrequenciesDesc WITH LemmaFrequencyRow.fromLemmaSql:
    SELECT dictionaryRef,
           SUM( possibleOccurrences ) AS possibleOccurrences,
           SUM( singleCandidateOccurrences ) AS singleCandidateOccurrences
        FROM ScopedLemmaFreq
        WHERE workId IN ?
        GROUP BY dictionaryRef
        ORDER BY possibleOccurrences DESC, dictionaryRef
        LIMIT :limit OFFSET :offset;

getLemmaFrequenciesAsc WITH LemmaFrequencyRow.fromLemmaSql:
    SELECT dictionaryRef,
           SUM( possibleOccurrences ) AS possibleOccurrences,
           SUM( singleCandidateOccurrences ) AS singleCandidateOccurrences
        FROM ScopedLemmaFreq
        WHERE workId IN ?
        GROUP BY dictionaryRef
        ORDER BY possibleOccurrences ASC, dictionaryRef
        LIMIT :limit OFFSET :offset;

-- Totals (additive); populusque counts as +2
getFrequencyCoverage WITH FrequencyCoverage:
    SELECT SUM( totalTokens ) AS totalTokens,
           SUM( noCandidateTokens ) AS noCandidateTokens,
           SUM( singleCandidateTokens ) AS singleCandidateTokens,
           SUM( multipleCandidateTokens ) AS multipleCandidateTokens
        FROM ScopedFreqTotals
        WHERE workId IN ?;

-- Totals (non-additive, need DISTINCT)
getTotalForms: SELECT COUNT( DISTINCT form ) AS totalForms FROM ScopedFormFreq WHERE workId IN ?;

getTotalMacronForms: SELECT COUNT( DISTINCT macronForm ) AS totalMacronForms FROM ScopedFormFreq WHERE workId IN ?;

getTotalLemmas: SELECT COUNT( DISTINCT dictionaryRef ) AS totalLemmas FROM ScopedLemmaFreq WHERE workId IN ?;

-- Group equal counts before accumulating coverage, so ties share a step
getFormCoverageSteps WITH TextCoverageStep:
    WITH Forms AS ( SELECT SUM( occurrences ) AS occurrences
                        FROM ScopedFormFreq
                        WHERE workId IN :workIds
                        GROUP BY form ),
         Steps AS ( SELECT occurrences AS minOccurrences,
                           SUM( occurrences ) AS units
                        FROM Forms
                        GROUP BY occurrences )
        SELECT minOccurrences,
               SUM( units ) OVER( ORDER BY minOccurrences DESC ) AS coveredUnits
            FROM Steps
            ORDER BY minOccurrences DESC;

getMacronFormCoverageSteps WITH TextCoverageStep:
    WITH Forms AS ( SELECT SUM( occurrences ) AS occurrences
                        FROM ScopedFormFreq
                        WHERE workId IN :workIds
                        GROUP BY macronForm ),
         Steps AS ( SELECT occurrences AS minOccurrences,
                           SUM( occurrences ) AS units
                        FROM Forms
                        GROUP BY occurrences )
        SELECT minOccurrences,
               SUM( units ) OVER( ORDER BY minOccurrences DESC ) AS coveredUnits
            FROM Steps
            ORDER BY minOccurrences DESC;

-- Attribute each lookup's units once, at its most frequent candidate's count
-- Lookups without candidates remain uncovered
getAnyCandidateLemmaCoverageSteps WITH TextCoverageStep:
    WITH Lemmas AS ( SELECT dictionaryRef,
                            SUM( possibleOccurrences ) AS occurrences
                         FROM ScopedLemmaFreq
                         WHERE workId IN :workIds
                         GROUP BY dictionaryRef ),
         LookupMaxCounts AS ( SELECT ScopedLookupLemmas.workId,
                                     ScopedLookupLemmas.lookupForm,
                                     ScopedLookupLemmas.alsoLowercase,
                                     MAX( Lemmas.occurrences ) AS occurrences
                                  FROM ScopedLookupLemmas
                                  INNER JOIN Lemmas
                                      ON Lemmas.dictionaryRef = ScopedLookupLemmas.dictionaryRef
                                  WHERE ScopedLookupLemmas.workId IN :workIds
                                  GROUP BY ScopedLookupLemmas.workId,
                                           ScopedLookupLemmas.lookupForm,
                                           ScopedLookupLemmas.alsoLowercase ),
         Steps AS ( SELECT LookupMaxCounts.occurrences AS minOccurrences,
                           SUM( ScopedLookupFreq.occurrences ) AS units
                        FROM LookupMaxCounts
                        INNER JOIN ScopedLookupFreq
                            ON ScopedLookupFreq.workId = LookupMaxCounts.workId
                               AND ScopedLookupFreq.lookupForm = LookupMaxCounts.lookupForm
                               AND ScopedLookupFreq.alsoLowercase = LookupMaxCounts.alsoLowercase
                        GROUP BY LookupMaxCounts.occurrences )
        SELECT minOccurrences,
               SUM( units ) OVER( ORDER BY minOccurrences DESC ) AS coveredUnits
            FROM Steps
            ORDER BY minOccurrences DESC;

-- The least frequent candidate sets the threshold where all candidates are included
getAllCandidateLemmasCoverageSteps WITH TextCoverageStep:
    WITH Lemmas AS ( SELECT dictionaryRef,
                            SUM( possibleOccurrences ) AS occurrences
                         FROM ScopedLemmaFreq
                         WHERE workId IN :workIds
                         GROUP BY dictionaryRef ),
         LookupMinCounts AS ( SELECT ScopedLookupLemmas.workId,
                                     ScopedLookupLemmas.lookupForm,
                                     ScopedLookupLemmas.alsoLowercase,
                                     MIN( Lemmas.occurrences ) AS occurrences
                                  FROM ScopedLookupLemmas
                                  INNER JOIN Lemmas
                                      ON Lemmas.dictionaryRef = ScopedLookupLemmas.dictionaryRef
                                  WHERE ScopedLookupLemmas.workId IN :workIds
                                  GROUP BY ScopedLookupLemmas.workId,
                                           ScopedLookupLemmas.lookupForm,
                                           ScopedLookupLemmas.alsoLowercase ),
         Steps AS ( SELECT LookupMinCounts.occurrences AS minOccurrences,
                           SUM( ScopedLookupFreq.occurrences ) AS units
                        FROM LookupMinCounts
                        INNER JOIN ScopedLookupFreq
                            ON ScopedLookupFreq.workId = LookupMinCounts.workId
                               AND ScopedLookupFreq.lookupForm = LookupMinCounts.lookupForm
                               AND ScopedLookupFreq.alsoLowercase = LookupMinCounts.alsoLowercase
                        GROUP BY LookupMinCounts.occurrences )
        SELECT minOccurrences,
               SUM( units ) OVER( ORDER BY minOccurrences DESC ) AS coveredUnits
            FROM Steps
            ORDER BY minOccurrences DESC;

-- Morphological matches for a plain form in the selected works.
-- DISTINCT removes matches repeated across works or macronized spellings.
getFormMorphIdentities WITH FrequencyMorphCandidate:
    SELECT DISTINCT form,
                    morphForm,
                    morphItem,
                    dictionaryRef
        FROM ResolvedFreqMorphForms
        WHERE workId IN :workIds
              AND form = :form
        ORDER BY morphForm, morphItem;

-- Morphological matches for the specified plain and macronized spellings.
getMacronFormMorphIdentities WITH FrequencyMorphCandidate:
    SELECT DISTINCT form,
                    morphForm,
                    morphItem,
                    dictionaryRef
        FROM ResolvedFreqMorphForms
        WHERE workId IN :workIds
              AND form = :form
              AND macronForm = :macronForm
        ORDER BY morphForm, morphItem;

-- Morphological matches for a lemma across its counted forms in the selected works.
getLemmaMorphIdentities WITH FrequencyMorphCandidate:
    SELECT DISTINCT form,
                    morphForm,
                    morphItem,
                    dictionaryRef
        FROM ResolvedFreqMorphForms
        WHERE workId IN :workIds
              AND dictionaryRef = :dictionaryRef
        ORDER BY morphForm, morphItem;