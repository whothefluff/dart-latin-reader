import 'package:latin_reader/src/component/dictionary/dictionaries_api.dart';
import 'package:latin_reader/src/component/dictionary/dictionary_entries_api.dart';
import 'package:latin_reader/src/component/dictionary/dictionary_entry_senses_api.dart';

CREATE TABLE "Dictionaries" (
    "id" TEXT NOT NULL CHECK( id LIKE '________-____-____-____-____________' ),
    "name" TEXT NOT NULL,
    "language" TEXT NOT NULL,
    "publisher" TEXT NOT NULL,
    "publicationDate" TEXT NOT NULL,
    PRIMARY KEY( id )
)
STRICT,
WITHOUT ROWID;

CREATE TABLE "DictionaryEntries" (
    "dictionary" TEXT NOT NULL,
    "key" TEXT NOT NULL, -- headword + homograph disambiguation number
    "partOfSpeech" TEXT,
    "inflection" TEXT,
    "idx" INTEGER NOT NULL CHECK( idx >= 0 ),
    PRIMARY KEY( dictionary, idx ), -- idx is the order of the entry in the dictionary
    FOREIGN KEY( dictionary ) REFERENCES Dictionaries( id ),
    UNIQUE( "key", dictionary ) -- index to filter dictionaries by entry key ('key' is quoted so that drift doesn't take it as a keyword)
)
STRICT,
WITHOUT ROWID;

CREATE TABLE "DictionaryAlphabets" (
    "dictionary" TEXT NOT NULL,
    "letter" TEXT NOT NULL,
    "firstEntryIndex" INTEGER NOT NULL,
    PRIMARY KEY( dictionary, letter ),
    FOREIGN KEY( dictionary, firstEntryIndex ) REFERENCES DictionaryEntries( dictionary, idx ),
    UNIQUE( dictionary, firstEntryIndex )
)
STRICT,
WITHOUT ROWID;

CREATE TABLE "DictEntrySenses" (
    "dictionary" TEXT NOT NULL,
    "entryKey" TEXT NOT NULL,
    "lvl" TEXT NOT NULL CHECK( lvl REGEXP '^\d{3}(\.\d{3})*$' ),
    "prettyLevel" TEXT NOT NULL,
    "content" TEXT NOT NULL,
    PRIMARY KEY( dictionary, entryKey, lvl ),
    FOREIGN KEY( entryKey, dictionary ) REFERENCES DictionaryEntries( "key", dictionary ) -- 'key' quoted because drift takes an unquoted identifier for the keyword KEY
)
STRICT,
WITHOUT ROWID;

CREATE TABLE "DictEntrySenseQuotes" (
    "dictionary" TEXT NOT NULL,
    "entryKey" TEXT NOT NULL,
    "lvl" TEXT NOT NULL,
    "seq" INTEGER NOT NULL CHECK( seq >= 0 ),
    "content" TEXT NOT NULL,
    "translation" TEXT,
    PRIMARY KEY( dictionary, entryKey, lvl, seq ),
    FOREIGN KEY( dictionary, entryKey, lvl ) REFERENCES DictEntrySenses( dictionary, entryKey, lvl )
)
STRICT,
WITHOUT ROWID;

CREATE TABLE "LnsRefResolutions"(
    "dictionaryRef" TEXT NOT NULL,
    "lnsEntryKey" TEXT,
    PRIMARY KEY( dictionaryRef )
)
STRICT, 
WITHOUT ROWID;

-- 'key' is quoted because otherwise drift takes it for the keyword KEY
fillDictionaryAlphabets: INSERT INTO "DictionaryAlphabets" SELECT dictionary, UPPER( SUBSTR( "key", 1, 1 ) ), MIN( idx ) FROM DictionaryEntries GROUP BY dictionary, UPPER( SUBSTR( "key", 1, 1 ) );

CREATE VIEW "dictionary.Dictionaries" AS
    SELECT Dictionaries.*,
           COALESCE( DictionaryCounts.numberOfEntries, 0 ) AS numberOfEntries
        FROM Dictionaries
        LEFT OUTER JOIN ( SELECT dictionary, 
                                 COUNT(*) AS numberOfEntries 
                              FROM DictionaryEntries 
                              GROUP BY dictionary ) AS DictionaryCounts
            ON Dictionaries.id = DictionaryCounts.dictionary;

getDictionaries WITH Dictionary: SELECT id, name, language, publisher, CAST( publicationDate AS DATETIME ) AS publicationDate, numberOfEntries FROM "dictionary.Dictionaries";

CREATE VIEW "dictionary.LewisAndShortDictionary" AS 
    SELECT id, 
           name, 
           language, 
           publisher, 
           CAST( publicationDate AS DATETIME ) AS publicationDate, 
           numberOfEntries 
        FROM "dictionary.Dictionaries" 
        WHERE name = 'Lewis & Short' -- literal 1 of 3
        LIMIT 1;

getLewisAndShortDictionary WITH Dictionary: SELECT * FROM "dictionary.LewisAndShortDictionary";

CREATE VIEW "dictionary.DictionaryEntries" AS
    SELECT DictionaryEntries.*,
           COALESCE( ( SELECT COUNT( * )  -- COALESCE is only for Drift's nullability analysis
                           FROM DictEntrySenses
                           WHERE DictEntrySenses.dictionary = DictionaryEntries.dictionary
                                 AND DictEntrySenses.entryKey = DictionaryEntries.key
                                 AND DictEntrySenses.lvl BETWEEN '000' AND '999' ),
                     0 ) AS numberOfSenses
        FROM DictionaryEntries
        ORDER BY DictionaryEntries.dictionary, DictionaryEntries.idx;

getDictionaryEntries WITH Entry: SELECT * FROM "dictionary.DictionaryEntries" WHERE dictionary = ?;

getDictionaryAlphabetLetterPosition: SELECT firstEntryIndex FROM "DictionaryAlphabets" WHERE dictionary = ? AND letter = ? LIMIT 1;

getDictionaryEntrySenses WITH EntrySense: SELECT prettyLevel, 
                                                 content,
                                                 LIST( SELECT seq,
                                                              content, 
                                                              translation 
                                                           FROM DictEntrySenseQuotes 
                                                           WHERE dictionary = Senses.dictionary 
                                                                 AND entryKey = Senses.entryKey
                                                                 AND lvl = Senses.lvl
                                                           ORDER BY dictionary, entryKey, lvl, seq ) AS Quotes
                                              FROM DictEntrySenses AS Senses 
                                              WHERE dictionary = ? AND entryKey = ?
                                              ORDER BY dictionary, entryKey, lvl;

-- headword is the entry key without its homograph number
CREATE VIRTUAL TABLE SearchableDictionaryEntries USING fts5(
    headword,
    headwordInVowelLetters,
    dictionary UNINDEXED,
    idx UNINDEXED,
    tokenize = "trigram remove_diacritics 0 case_sensitive 0"
);

fillSearchableDictionaryEntries:
    INSERT INTO SearchableDictionaryEntries( headword, headwordInVowelLetters, dictionary, idx )
        SELECT headword,
               IIF( headword GLOB '*[jvJV]*', "REPLACE"( "REPLACE"( "REPLACE"( "REPLACE"( headword, 'j', 'i' ), 'J', 'I' ), 'v', 'u' ), 'V', 'U' ), NULL ),
               dictionary,
               idx
            FROM ( SELECT RTRIM( "key", '0123456789' ) AS headword, -- quoted because drift takes an unquoted 'key' for the keyword KEY
                          dictionary,
                          idx
                       FROM DictionaryEntries );

searchDictionaryEntriesWithFts(:term AS TEXT) WITH Entry:
    SELECT Entries.*
        FROM SearchableDictionaryEntries AS Search
        INNER JOIN "dictionary.DictionaryEntries" AS Entries
            ON Search.dictionary = Entries.dictionary
               AND Search.idx = Entries.idx
        WHERE Search.headword MATCH :term
              AND Entries.dictionary = :dictionary
        ORDER BY BM25( SearchableDictionaryEntries ), Entries.dictionary, Entries.idx;

searchDictionaryEntriesWithLike(:term AS TEXT) WITH Entry:
    SELECT Entries.*
        FROM SearchableDictionaryEntries AS Search
        INNER JOIN "dictionary.DictionaryEntries" AS Entries
            ON Search.dictionary = Entries.dictionary
               AND Search.idx = Entries.idx
        WHERE Search.headword LIKE :term
              AND Entries.dictionary = :dictionary
        ORDER BY Entries.dictionary, Entries.idx;

searchDictionaryEntriesInVowelLettersWithFts(:term AS TEXT) WITH Entry:
    SELECT Entries.*
        FROM SearchableDictionaryEntries AS Search
        INNER JOIN "dictionary.DictionaryEntries" AS Entries
            ON Search.dictionary = Entries.dictionary
               AND Search.idx = Entries.idx
        WHERE Search.headwordInVowelLetters MATCH :term
              AND Entries.dictionary = :dictionary
        ORDER BY BM25( SearchableDictionaryEntries ), Entries.dictionary, Entries.idx;

searchDictionaryEntriesInVowelLettersWithLike(:term AS TEXT) WITH Entry:
    SELECT Entries.*
        FROM SearchableDictionaryEntries AS Search
        INNER JOIN "dictionary.DictionaryEntries" AS Entries
            ON Search.dictionary = Entries.dictionary
               AND Search.idx = Entries.idx
        WHERE Search.headwordInVowelLetters LIKE :term
              AND Entries.dictionary = :dictionary
        ORDER BY Entries.dictionary, Entries.idx;

CREATE VIEW "dictionary.ResolvedLnsRefs" AS
    SELECT LnsRefResolutions.dictionaryRef,
           DictionaryEntries.key,
           DictionaryEntries.inflection,
           DictionaryEntries.partOfSpeech
        FROM LnsRefResolutions
        INNER JOIN DictionaryEntries
            ON DictionaryEntries.key = LnsRefResolutions.lnsEntryKey
               AND DictionaryEntries.dictionary = ( SELECT id 
                                                        FROM Dictionaries 
                                                        WHERE name = 'Lewis & Short' -- literal 2 of 3
                                                        LIMIT 1 );

getBasicLnsInfo: SELECT * FROM "dictionary.ResolvedLnsRefs" WHERE dictionaryRef IN ?;