import 'package:latin_reader/src/component/morph_analysis/morphological_search_api.dart';
import 'package:latin_reader/src/component/morph_analysis/morphological_details_api.dart';

CREATE TABLE "MorphologicalDetails"(
    "form" TEXT NOT NULL,
    "item" INTEGER NOT NULL CHECK( item >= 0 ),
    "dictionaryRef" TEXT NOT NULL,
    PRIMARY KEY( form, item )
) 
STRICT, 
WITHOUT ROWID;

/* 
for the coexistance of several sources of analyses, something like this would be necessary
but (for the time being) forcing all navigations from an analysis to a L&S entry will suffice

CREATE TABLE "MorphologicalDetails"(
    "form" TEXT NOT NULL,
    "item" INTEGER NOT NULL CHECK( item >= 0 ),
    PRIMARY KEY( form, item )
) STRICT, WITHOUT ROWID;

CREATE TABLE "MorphologicalDetailDicts"(
    "form" TEXT NOT NULL,
    "item" INTEGER NOT NULL,
    "dictionary" TEXT NOT NULL,
    "dictionaryRef" TEXT NOT NULL,
    PRIMARY KEY( form, item, dictionary ),
    FOREIGN KEY( form, item ) REFERENCES MorphologicalDetails( form, item ),
    --FOREIGN KEY( dictionary, dictionaryRef ) REFERENCES DictionaryEntries( dictionary, lemma )
) STRICT, WITHOUT ROWID;

 */

CREATE TABLE "MorphologicalDetailInflections"(
    "form" TEXT NOT NULL,
    "macronizedForm" TEXT NOT NULL GENERATED ALWAYS AS ( 
        CONCAT( "REPLACE"( stem, '-', '' ), suffix ) 
    ) VIRTUAL,
    "item" INTEGER NOT NULL,
    "cnt" INTEGER NOT NULL CHECK( cnt >= 0 ),
    "partOfSpeech" TEXT NOT NULL CHECK( partOfSpeech IN 
        ( 'adjective', 'adverb', 'conjunction', 'interjection', 'irregular', 'noun', 'numeral', 'preposition', 'pronoun', 'verb' ) 
    ),
    "stem" TEXT NOT NULL,
    "suffix" TEXT,
    "segmentsInfo" TEXT,
    "gender" TEXT,
    "number" TEXT,
    "declension" TEXT,
    "gramCase" TEXT,
    "verbForm" TEXT,
    "tense" TEXT,
    "voice" TEXT,
    "person" TEXT,
    PRIMARY KEY( form, item, cnt ),
    FOREIGN KEY( form, item ) REFERENCES MorphologicalDetails( form, item )
)
STRICT,
WITHOUT ROWID;

CREATE TABLE "CountableWordCandidateAnalyses"(
    "workId" TEXT NOT NULL,
    "idx" INTEGER NOT NULL,
    "componentOrdinal" INTEGER NOT NULL CHECK( componentOrdinal IN (0, 1) ), -- 1 is the enclitic
    "form" TEXT NOT NULL,
    "item" INTEGER NOT NULL,
    PRIMARY KEY( workId, idx, componentOrdinal, form, item ),
    FOREIGN KEY( form, item ) REFERENCES MorphologicalDetails( form, item )
)
STRICT,
WITHOUT ROWID;

CREATE VIRTUAL TABLE SearchableMorphDetInflections USING fts5(
    form,
    macronizedForm,
    item UNINDEXED,
    cnt UNINDEXED,
    tokenize = "trigram remove_diacritics 0 case_sensitive 0"
);

fillSearchableMorphDetInflections:
    INSERT INTO SearchableMorphDetInflections( form, macronizedForm, item, cnt )
        SELECT form,
               macronizedForm,
               item,
               cnt
            FROM MorphologicalDetailInflections;

CREATE VIEW "morphology.Peek" AS
    SELECT Infl.form AS form,
           CASE WHEN Infl.partOfSpeech IN ( 'adjective', 'noun' )
                     AND Infl.verbForm IS NOT NULL
                THEN NULL
                ELSE Infl.partOfSpeech
           END AS partOfSpeech,
           MorphologicalDetails.dictionaryRef AS dictionaryRef,
           CASE Infl.partOfSpeech
                WHEN 'adjective' THEN COALESCE( IIF( Infl.verbForm IS NULL AND Infl.segmentsInfo IN ( 'irregular', 'indeclinable' ),
                                                     Infl.segmentsInfo,
                                                     NULL ),
                                                Infl.verbForm )
                WHEN 'adverb' THEN IIF( Infl.suffix IS NOT NULL, 
                                        '-' || Infl.suffix || ' suffix', 
                                        NULL )
                WHEN 'conjunction' THEN NULL
                WHEN 'interjection' THEN NULL
                WHEN 'irregular' THEN Infl.segmentsInfo
                WHEN 'noun' THEN COALESCE( Infl.verbForm, Infl.declension || ' declension' )
                WHEN 'numeral' THEN NULL
                WHEN 'preposition' THEN NULL
                WHEN 'pronoun' THEN NULL
                WHEN 'verb' THEN Infl.segmentsInfo
           END AS additional,
           Infl.item AS item,
           Infl.cnt AS cnt
        FROM MorphologicalDetailInflections AS Infl
        INNER JOIN MorphologicalDetails
            ON Infl.form = MorphologicalDetails.form
               AND Infl.item = MorphologicalDetails.item
        ORDER BY Infl.form, Infl.item, Infl.cnt;

searchMorphologicalDataWithFts WITH Result: SELECT Peek.*, Search.macronizedForm
                                                FROM SearchableMorphDetInflections AS Search
                                                INNER JOIN "morphology.Peek" AS Peek
                                                    ON Search.form = Peek.form 
                                                       AND Search.item = Peek.item
                                                       AND Search.cnt = Peek.cnt
                                                WHERE Search.form MATCH ?
                                                ORDER BY BM25( SearchableMorphDetInflections ), Peek.form, Peek.item, Peek.cnt;

searchMorphologicalDataWithLike WITH Result: SELECT Peek.*, Search.macronizedForm
                                                 FROM SearchableMorphDetInflections AS Search
                                                 INNER JOIN "morphology.Peek" AS Peek
                                                      ON Search.form = Peek.form 
                                                         AND Search.item = Peek.item
                                                         AND Search.cnt = Peek.cnt
                                                 WHERE Search.form LIKE ?
                                                 ORDER BY Peek.form, Peek.item, Peek.cnt;

searchMacronizedMorphologicalDataWithFts WITH Result: SELECT Peek.*, Search.macronizedForm
                                                              FROM SearchableMorphDetInflections AS Search
                                                              INNER JOIN "morphology.Peek" AS Peek
                                                                  ON Search.form = Peek.form
                                                                     AND Search.item = Peek.item
                                                                     AND Search.cnt = Peek.cnt
                                                              WHERE Search.macronizedForm MATCH ?
                                                              ORDER BY BM25( SearchableMorphDetInflections ), Peek.form, Peek.item, Peek.cnt;

searchMacronizedMorphologicalDataWithLike WITH Result: SELECT Peek.*, Search.macronizedForm
                                                           FROM SearchableMorphDetInflections AS Search
                                                           INNER JOIN "morphology.Peek" AS Peek
                                                               ON Search.form = Peek.form
                                                                  AND Search.item = Peek.item
                                                                  AND Search.cnt = Peek.cnt
                                                           WHERE Search.macronizedForm LIKE ?
                                                           ORDER BY Peek.form, Peek.item, Peek.cnt;

getAnalysisKeysOf WITH AnalysisKey.fromSql: SELECT form, CAST( item AS INT ) AS item, CAST( cnt AS INT ) AS cnt FROM SearchableMorphDetInflections WHERE form LIKE ? ORDER BY form, item, cnt;

getAnalysisKeysOfMacronized WITH AnalysisKey.fromSql: SELECT form, CAST( item AS INT ) AS item, CAST( cnt AS INT ) AS cnt FROM SearchableMorphDetInflections WHERE macronizedForm LIKE ? ORDER BY form, item, cnt;

CREATE VIEW "morphology.Analyses" WITH Analysis AS 
    SELECT Infl.form,
           Infl.item,
           Infl.cnt,
           Infl.macronizedForm,
           MorphologicalDetails.dictionaryRef,
           Infl.partOfSpeech,
           Infl.stem,
           Infl.suffix,
           Infl.segmentsInfo,
           Infl.gender,
           Infl.number,
           Infl.declension,
           Infl.gramCase,
           Infl.verbForm,
           Infl.tense,
           Infl.voice,
           Infl.person,
           Peek.additional
        FROM MorphologicalDetailInflections AS Infl
        INNER JOIN MorphologicalDetails
            ON Infl.form = MorphologicalDetails.form
               AND Infl.item = MorphologicalDetails.item
        INNER JOIN "morphology.Peek" AS Peek
            ON Infl.form = Peek.form
               AND Infl.item = Peek.item
               AND Infl.cnt = Peek.cnt;

